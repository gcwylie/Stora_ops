generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String
  shopCode     String?
  createdAt    DateTime @default(now())
}

model Employee {
  id                String          @id @default(cuid())
  name              String
  groupName         String
  homeShopCode      String
  alsoShopCode      String?
  active            Boolean         @default(true)
  salary            Boolean         @default(false)
  hourlyRate        Float?
  caspecoEmployeeId String?
  shifts            ScheduleShift[]
  createdAt         DateTime        @default(now())
}

model LabourSettings {
  id              Int   @id @default(1)
  fohAvg          Float @default(153)
  kitchenAvg      Float @default(153)
  bakeryAvg       Float @default(0)
  targetFohPct    Float @default(21)
  semesterPct     Float @default(12)
  agaPct          Float @default(31.42)
  yearlyTargetPct Float @default(10)
}

model ScheduleShift {
  id         String   @id @default(cuid())
  shopCode   String
  weekMonday DateTime @db.Date
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayIndex   Int
  shiftId    String
  startTime  String
  endTime    String

  @@unique([shopCode, weekMonday, employeeId, dayIndex])
  @@index([weekMonday])
}

model SalesDay {
  date     DateTime @db.Date
  shopCode String
  exclOre  Int
  inclOre  Int
  source   String

  @@id([date, shopCode])
}

model SalesPeriod {
  id       String   @id @default(cuid())
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  shopCode String
  exclOre  Int
  inclOre  Int
  source   String

  @@unique([fromDate, toDate, shopCode])
}

model StaffCostMonth {
  month    String
  shopCode String
  costKr   Int

  @@id([month, shopCode])
}

model CatalogueItem {
  n             Int         @id
  category      String
  name          String
  supplier      String
  sites         String[]
  orderUnit     String
  primaryUnit   String
  primaryToBase Float?
  baseUnit      String?
  perPiece      Float?
  priceSek      Float
  note          String      @default("")
  alts          Json
  lines         StockLine[]
}

model CategoryLimit {
  category String @id
  kg       Float?
  litres   Float?
  pcs      Float?
  units    Float?
  valueCap Float?
}

model StockSettings {
  id               Int   @id @default(1)
  maxUnits         Float @default(100)
  valueCap         Float @default(20000)
  countOverdueDays Int   @default(7)
}

model StockCount {
  id          String      @id @default(cuid())
  shopCode    String
  countDate   DateTime    @db.Date
  countedBy   String
  status      String
  createdAt   DateTime    @default(now())
  submittedAt DateTime?
  lines       StockLine[]

  @@index([shopCode, countDate])
}

model StockLine {
  id      String        @id @default(cuid())
  countId String
  count   StockCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemN   Int
  item    CatalogueItem @relation(fields: [itemN], references: [n])
  qty     Float?
  altQty  Float?
  altUnit String?
  note    String        @default("")
  ack     Boolean       @default(false)

  @@unique([countId, itemN])
}

model CaspecoQueue {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}
